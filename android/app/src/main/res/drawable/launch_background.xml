<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12 (after that, see windowSplashScreenBackground in
     styles.xml): the app's badge on the menu's cream. launch_image is rendered by
     tool/generate_icons_test.dart. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
